{
  "mode": "webvpn",
  "health_resource": "https://library.fudan.edu.cn/",
  "default_ssh_target": "campus",
  "relay": {
    "url": "http://relay.campus.example:18080",
    "key_file": "/absolute/private/path/relay.key",
    "targets": ["campus"]
  },
  "ssh_targets": {
    "campus": {
      "hostname": "server.campus.example",
      "port": 2222,
      "user": "YOUR_SERVER_USER",
      "identity_file": "/absolute/path/to/your/existing/ssh_key",
      "host_key_alias": "campus-fudangateway",
      "known_hosts_file": "/absolute/private/path/known_hosts"
    }
  }
}
